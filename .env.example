# =============================================================================
# Georgian Games — Environment Variables
# =============================================================================
# Copy to .env and fill in values. NEVER commit real secrets.
#
# BROWSER-SAFE (Angular / public client):
#   SUPABASE_URL + SUPABASE_PUBLISHABLE_KEY (sb_publishable_...)
#   Configure these in apps/web/src/environments/environment*.ts
#   Never put SUPABASE_SECRET_KEY in Angular.
#
# SERVER-ONLY (Colyseus game server):
#   SUPABASE_SECRET_KEY (sb_secret_...)
#   User access tokens are verified via JWKS (ES256), NOT a JWT shared secret.
# =============================================================================

# --- Shared ---
SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# Publishable key (safe for browser) — formerly "anon"
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Game server WebSocket URL (browser connects here)
GAME_SERVER_URL=ws://localhost:2567

# --- Server-only (apps/game-server) ---
# Secret key — NEVER expose to the browser — formerly "service_role"
SUPABASE_SECRET_KEY=sb_secret_...

# Colyseus
PORT=2567
NODE_ENV=development

# Reconnection grace period (ms)
RECONNECT_GRACE_MS=60000

# Rate limiting
RATE_LIMIT_CREATE_ROOM_PER_MIN=10
RATE_LIMIT_JOIN_ROOM_PER_MIN=30

# Browser origins allowed to call the game-server HTTP API (comma-separated).
# Production (Render) must include the Netlify site origin — never use "*".
# CORS_ORIGINS=https://gartoba.netlify.app,http://localhost:4200
CORS_ORIGINS=http://localhost:4200

# JWT verification (no secret required):
#   {SUPABASE_URL}/auth/v1/.well-known/jwks.json
# Do NOT set SUPABASE_JWT_SECRET / Legacy JWT Secret for user token verification.
